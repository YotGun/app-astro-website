{
	"name": "app-astro-website",
	"description": "Private academic notes and files vault.",
	"cloudflare": {
		"label": "Astro Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
		"publish": true
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.2",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.10",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.3",
		"astro": "5.16.9",
		"dexie": "^4.4.5",
		"highlight.js": "^11.12.0",
		"katex": "^0.18.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"typescript": "5.9.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/react": "^6.0.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"concurrently": "^10.0.5",
		"wrangler": "4.88.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "astro build && wrangler d1 migrations apply private-d1 --remote && wrangler deploy",
		"dev": "mkdir -p dist && concurrently -k -n astro,worker -c cyan,magenta \"astro dev --port 4321\" \"wrangler dev --port 8787\"",
		"preview": "astro build && wrangler dev",
		"db:migrate": "wrangler d1 migrations apply private-d1 --local",
		"db:migrate:remote": "wrangler d1 migrations apply private-d1 --remote"
	},
	"type": "module"
}
